---
import type { Locale } from "../../../i18n/config";
import { useTranslations } from "../../../i18n";
import Container from "../../ui/Container.astro";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<section id="process" class="bg-[#f8efe0] py-20 text-black md:py-32">
  <Container>
    <div class="grid gap-8 md:grid-cols-[0.72fr_1.28fr]">
      <div data-motion-reveal>
        <p
          class="text-sm font-semibold uppercase tracking-[0.26em] text-black/48"
        >
          {t.home.process.label}
        </p>
        <h2
          class="mt-5 text-4xl font-black leading-none tracking-[-0.06em] md:text-6xl"
        >
          {t.home.process.title}
        </h2>
      </div>
      <div class="grid gap-4" data-motion-stagger>
        {
          t.home.process.items.map((item, index) => (
            <article
              class="grid gap-5 rounded-[2rem] border border-black/10 bg-white/55 p-6 shadow-[0_24px_80px_rgb(24_24_22/0.08)] backdrop-blur md:grid-cols-[auto_1fr] md:p-8"
              data-motion-item
            >
              <span class="grid size-12 place-items-center rounded-full bg-black text-sm font-bold text-[#f4e8d0]">
                0{index + 1}
              </span>
              <div>
                <h3 class="text-2xl font-black tracking-[-0.045em]">
                  {item.title}
                </h3>
                <p class="mt-2 max-w-2xl leading-7 text-black/62">
                  {item.text}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Container>
</section>
