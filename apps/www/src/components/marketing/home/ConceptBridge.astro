---
import { Image } from "astro:assets";
import phoneMockup from "../../../assets/images/phone-2.png";
import type { Locale } from "../../../i18n/config";
import { useTranslations } from "../../../i18n";
import Container from "../../ui/Container.astro";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<section
  id="concept"
  class="relative overflow-hidden py-20 text-white md:py-32"
>
  <div
    class="absolute left-[-8rem] top-20 h-[28rem] w-[28rem] rounded-full bg-[#b55635]/14 blur-3xl"
  >
  </div>
  <div
    class="absolute right-[-10rem] top-1/3 h-[34rem] w-[34rem] rounded-full bg-[#f4e8d0]/10 blur-3xl"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>

  <Container class="relative">
    <div class="border-t border-white/10 pt-14">
      <div
        class="grid gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] lg:items-center"
      >
        <div data-motion-reveal>
          <p
            class="text-sm font-semibold uppercase tracking-[0.26em] text-[#f4e8d0]/60"
          >
            {t.home.concept.label}
          </p>
          <h2
            class="mt-7 max-w-4xl text-4xl font-black leading-[0.94] tracking-[-0.065em] text-[#eee7da] md:text-6xl"
          >
            {t.home.concept.title}
          </h2>
          <p
            class="mt-7 max-w-2xl text-xl leading-8 tracking-[-0.035em] text-white/68 md:text-2xl md:leading-9"
          >
            {t.home.concept.text}
          </p>

          <dl
            class="mt-9 grid grid-cols-3 gap-4 border-y border-white/10 py-7"
          >
            {
              t.home.concept.stats.map((stat) => (
                <div>
                  <dt
                    class="text-3xl font-black tracking-[-0.05em] text-[#f4e8d0] md:text-4xl"
                    data-count-to={String(stat.value)}
                    data-count-suffix={stat.suffix}
                  >
                    {stat.value}
                    {stat.suffix}
                  </dt>
                  <dd class="mt-2 text-xs leading-5 text-white/55">
                    {stat.label}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-10 grid gap-3 sm:grid-cols-2">
            {
              t.home.concept.checks.map((check, index) => (
                <article class="group rounded-[1.65rem] border border-white/10 bg-white/[0.035] p-5 transition duration-300 hover:-translate-y-0.5 hover:border-[#f4e8d0]/35 hover:bg-[#f4e8d0]/[0.055]">
                  <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#f4e8d0]/45">
                    0{index + 1}
                  </p>
                  <h3 class="mt-5 text-lg font-black tracking-[-0.045em] text-white/92 group-hover:text-[#f4e8d0]">
                    {check.title}
                  </h3>
                  <p class="mt-2 text-sm leading-6 text-white/56">
                    {check.text}
                  </p>
                </article>
              ))
            }
          </div>

          <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a
              class="inline-flex w-fit rounded-full border border-[#f4e8d0]/30 px-6 py-3 text-sm font-semibold text-[#f4e8d0] transition hover:border-[#f4e8d0] hover:bg-[#f4e8d0] hover:!text-[#111113] focus-visible:bg-[#f4e8d0] focus-visible:!text-[#111113]"
              href="#styles"
              data-magnetic="0.3"
            >
              {t.home.concept.cta}
            </a>
            <p class="max-w-xs text-sm leading-6 text-white/45">
              {t.home.concept.microcopy}
            </p>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[620px]" data-motion-reveal>
          <div
            class="absolute left-1/2 top-1/2 h-[78%] w-[74%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#f4e8d0]/12 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <Image
            class="relative z-10 mx-auto w-full max-w-[560px] drop-shadow-[0_34px_120px_rgba(0,0,0,0.62)]"
            src={phoneMockup}
            alt={t.home.concept.phone.ariaLabel}
            width={1122}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
