---
import type { Locale } from "../../../i18n/config";
import { useTranslations } from "../../../i18n";
import Container from "../../ui/Container.astro";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const pricing = t.home.pricing;
const availableStatus = "available";

const numberLocale = locale === "it" ? "it-IT" : "en-US";

function formatPrice(price: number | null) {
  if (price === null) return pricing.comingSoonLabel;

  return new Intl.NumberFormat(numberLocale, {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(price);
}
---

<section
  id="pricing"
  class="relative overflow-hidden bg-[#f8efe0] py-20 text-black md:py-32"
  data-pricing-preview
  data-base-price={pricing.base.price}
  data-locale={numberLocale}
>
  <div
    class="absolute left-1/2 top-0 h-96 w-96 -translate-x-1/2 rounded-full bg-[#b55635]/12 blur-3xl"
  >
  </div>

  <Container class="relative">
    <div class="grid gap-8 md:grid-cols-[0.82fr_1.18fr] md:items-end">
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.26em] text-black/48"
        >
          {pricing.label}
        </p>
        <h2
          class="mt-5 max-w-3xl text-4xl font-black leading-[0.96] tracking-[-0.06em] md:text-6xl"
        >
          {pricing.title}
        </h2>
      </div>
      <div class="max-w-2xl md:justify-self-end">
        <p class="text-xl leading-8 tracking-[-0.035em] text-black/64">
          {pricing.text}
        </p>
        <details
          class="mt-5 rounded-3xl border border-black/10 bg-white/45 p-5 shadow-[0_20px_70px_rgb(24_24_22/0.08)]"
        >
          <summary
            class="cursor-pointer text-sm font-bold uppercase tracking-[0.18em] text-black/55"
          >
            {pricing.helperTitle}
          </summary>
          <p class="mt-3 leading-7 text-black/62">{pricing.helperText}</p>
        </details>
      </div>
    </div>

    <div
      class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start"
    >
      <div class="space-y-6">
        <article
          class="rounded-4xl border border-black/10 bg-white/70 p-6 shadow-[0_24px_80px_rgb(24_24_22/0.08)] backdrop-blur md:p-7"
        >
          <div
            class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between"
          >
            <div>
              <p
                class="text-xs font-bold uppercase tracking-[0.2em] text-black/45"
              >
                {pricing.includedLabel}
              </p>
              <h3 class="mt-3 text-3xl font-black tracking-[-0.055em]">
                {pricing.base.title}
              </h3>
              <p class="mt-4 max-w-3xl leading-7 text-black/62">
                {pricing.base.description}
              </p>
            </div>
            <p
              class="w-fit rounded-full bg-black px-5 py-3 text-lg font-black text-[#f4e8d0]"
            >
              {formatPrice(pricing.base.price)}
            </p>
          </div>
        </article>

        <div>
          <h3
            class="text-sm font-bold uppercase tracking-[0.22em] text-black/45"
          >
            {pricing.modulesLabel}
          </h3>
          <div class="mt-4 grid gap-4 md:grid-cols-2">
            {
              pricing.modules.map((item) => {
                const isAvailable =
                  item.status === availableStatus && item.price !== null;

                return (
                  <label
                    class:list={[
                      "group block rounded-[1.65rem] border bg-white/62 p-5 shadow-[0_18px_60px_rgb(24_24_22/0.07)] transition",
                      isAvailable
                        ? "cursor-pointer border-black/10 hover:-translate-y-0.5 hover:bg-white"
                        : "cursor-not-allowed border-black/10 opacity-65",
                    ]}
                  >
                    <div class="flex items-start gap-4">
                      <input
                        class="mt-1 size-5 accent-[#b55635]"
                        type="checkbox"
                        data-price={item.price ?? 0}
                        data-pricing-option
                        disabled={!isAvailable}
                      />
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                          <h4 class="text-xl font-black tracking-[-0.045em]">
                            {item.title}
                          </h4>
                          <span
                            class:list={[
                              "rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.12em]",
                              isAvailable
                                ? "bg-[#b55635]/12 text-[#7e3021]"
                                : "bg-black/8 text-black/48",
                            ]}
                          >
                            {isAvailable
                              ? formatPrice(item.price)
                              : pricing.comingSoonLabel}
                          </span>
                        </div>
                        <p class="mt-3 text-sm leading-6 text-black/62">
                          {item.description}
                        </p>
                      </div>
                    </div>
                  </label>
                );
              })
            }
          </div>
        </div>

        <div>
          <h3
            class="text-sm font-bold uppercase tracking-[0.22em] text-black/45"
          >
            {pricing.addonsLabel}
          </h3>
          <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {
              pricing.addons.map((item) => {
                const isAvailable =
                  item.status === availableStatus && item.price !== null;

                return (
                  <label
                    class:list={[
                      "group block rounded-[1.45rem] border bg-white/55 p-5 transition",
                      isAvailable
                        ? "cursor-pointer border-black/10 hover:bg-white"
                        : "cursor-not-allowed border-black/10 opacity-65",
                    ]}
                  >
                    <div class="flex items-start gap-3">
                      <input
                        class="mt-1 size-5 accent-[#b55635]"
                        type="checkbox"
                        data-price={item.price ?? 0}
                        data-pricing-option
                        disabled={!isAvailable}
                      />
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h4 class="font-black tracking-[-0.035em]">
                            {item.title}
                          </h4>
                          <span class="rounded-full bg-black/8 px-2.5 py-1 text-[0.66rem] font-bold uppercase tracking-[0.12em] text-black/48">
                            {isAvailable
                              ? formatPrice(item.price)
                              : pricing.comingSoonLabel}
                          </span>
                        </div>
                        <p class="mt-3 text-sm leading-6 text-black/60">
                          {item.description}
                        </p>
                      </div>
                    </div>
                  </label>
                );
              })
            }
          </div>
        </div>

        <article
          class="rounded-4xl border border-dashed border-black/18 bg-black/[0.035] p-6"
        >
          <div
            class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"
          >
            <div>
              <p
                class="text-xs font-bold uppercase tracking-[0.2em] text-black/45"
              >
                {pricing.comingSoonLabel}
              </p>
              <h3 class="mt-3 text-2xl font-black tracking-[-0.045em]">
                {pricing.future.title}
              </h3>
              <p class="mt-3 max-w-3xl leading-7 text-black/62">
                {pricing.future.description}
              </p>
            </div>
            <span
              class="w-fit rounded-full bg-black/8 px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] text-black/48"
            >
              {pricing.unavailableLabel}
            </span>
          </div>
        </article>
      </div>

      <aside
        class="sticky top-6 rounded-4xl border border-black/10 bg-[#111113] p-6 text-white shadow-2xl lg:top-10"
        aria-live="polite"
        aria-atomic="true"
      >
        <p
          class="text-xs font-bold uppercase tracking-[0.22em] text-[#f4e8d0]/55"
        >
          {pricing.totalLabel}
        </p>
        <p
          class="mt-4 text-6xl font-black tracking-[-0.08em] text-[#f4e8d0]"
          data-pricing-total
          data-motion-pricing-total
        >
          {formatPrice(pricing.base.price)}
        </p>
        <p class="mt-4 leading-7 text-white/72">
          {pricing.base.title} + <span data-pricing-count>0</span>
          {pricing.selectedLabel.toLowerCase()}
        </p>
        <a
          class="mt-7 inline-flex w-full justify-center rounded-full bg-[#f4e8d0] px-7 py-4 text-center text-base font-bold tracking-[-0.03em] !text-[#111113] transition hover:-translate-y-0.5 hover:bg-white hover:!text-[#111113]"
          href="#contact-details"
        >
          {pricing.sendPlan}
        </a>
      </aside>
    </div>
  </Container>
</section>

<script is:inline>
  const pricingRoot = document.querySelector("[data-pricing-preview]");

  if (pricingRoot) {
    const basePrice = Number(pricingRoot.dataset.basePrice ?? 0);
    const total = pricingRoot.querySelector("[data-pricing-total]");
    const count = pricingRoot.querySelector("[data-pricing-count]");
    const options = [...pricingRoot.querySelectorAll("[data-pricing-option]")];
    const formatter = new Intl.NumberFormat(
      pricingRoot.dataset.locale ?? "en-US",
      {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0,
      },
    );

    function updateTotal(shouldPulse = false) {
      const selected = options.filter(
        (option) => option.checked && !option.disabled,
      );
      const selectedTotal = selected.reduce(
        (sum, option) => sum + Number(option.dataset.price ?? 0),
        0,
      );

      if (total)
        total.textContent = formatter.format(basePrice + selectedTotal);
      if (count) count.textContent = String(selected.length);

      if (shouldPulse) {
        document.dispatchEvent(new CustomEvent("vicino:pricing-change"));
      }
    }

    options.forEach((option) =>
      option.addEventListener("change", () => updateTotal(true)),
    );
    updateTotal();
  }
</script>
