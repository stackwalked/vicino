---
import type { Locale } from "../../../i18n/config";
import { contact } from "../../../data/contact";
import { useTranslations } from "../../../i18n";
import Container from "../../ui/Container.astro";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<section
  id="start-project"
  class="relative overflow-hidden py-20 text-white md:py-32"
>
  <Container class="relative">
    <div
      class="mx-auto max-w-5xl rounded-[2.75rem] border border-[#f4e8d0]/14 bg-[#f4e8d0]/[0.075] p-8 text-center shadow-[0_28px_90px_rgb(0_0_0/0.22)] backdrop-blur-xl md:p-14"
      data-motion-reveal
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.26em] text-[#f4e8d0]/54"
      >
        {t.home.finalCta.label}
      </p>
      <h2
        class="mt-5 text-4xl font-black leading-[0.96] tracking-[-0.06em] text-[#fff8ea] md:text-7xl"
      >
        {t.home.finalCta.title}
      </h2>
      <p
        class="mx-auto mt-7 max-w-2xl text-xl leading-8 tracking-[-0.035em] text-[#f4e8d0]/64"
      >
        {t.home.finalCta.text}
      </p>
      <div
        class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
      >
        <a
          class="relative isolate inline-flex overflow-hidden rounded-full bg-[#f4e8d0] px-9 py-5 text-lg font-semibold tracking-[-0.035em] !text-[#111113] transition duration-300 after:absolute after:inset-y-0 after:left-[-45%] after:w-1/3 after:-translate-x-full after:skew-x-[-18deg] after:bg-gradient-to-r after:from-transparent after:via-white/55 after:to-transparent after:transition-transform after:duration-700 after:ease-out hover:-translate-y-0.5 hover:bg-white hover:!text-[#111113] hover:after:translate-x-[420%] focus-visible:after:translate-x-[420%]"
          href={contact.whatsappUrl}
          rel="noreferrer"
          target="_blank"
          data-magnetic="0.18">{t.home.finalCta.primaryCta}</a
        >
        <a
          class="inline-flex rounded-full border border-[#f4e8d0]/25 px-8 py-5 text-base font-semibold text-[#f4e8d0]/82 transition duration-300 hover:border-[#f4e8d0] hover:text-[#f4e8d0]"
          href="#styles">{t.home.finalCta.secondaryCta}</a
        >
      </div>
    </div>
  </Container>
</section>
