---
import forkSpaghetti from "../../assets/images/fork-spaghetti.png";
import Container from "../ui/Container.astro";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<section class="relative isolate overflow-hidden bg-[#0d0d0d] text-white">
  <div
    class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/60 to-transparent"
  >
  </div>
  <Container class="relative min-h-[760px] pt-44 md:min-h-screen md:pt-56">
    <div
      class="grid gap-14 lg:grid-cols-[minmax(0,0.95fr)_minmax(320px,0.7fr)] lg:items-center"
    >
      <div class="max-w-4xl">
        <p
          class="mb-7 text-sm font-semibold uppercase tracking-[0.24em] text-[#f4e8d0]/70"
        >
          {t.home.eyebrow}
        </p>
        <h1
          class="max-w-[820px] text-[clamp(3.4rem,7vw,6.7rem)] font-black leading-[0.98] tracking-[-0.065em] text-[#e9e4db]"
        >
          {t.home.title}
        </h1>
        <p
          class="mt-9 max-w-[760px] text-[clamp(1.65rem,2.35vw,2.55rem)] font-medium leading-[1.15] tracking-[-0.055em] text-white/95"
        >
          {t.home.intro}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            class="inline-flex w-fit rounded-full bg-[#f4e8d0] px-10 py-5 text-xl font-medium tracking-[-0.04em] text-black transition hover:bg-white"
            href="#contact"
          >
            {t.home.primaryCta}
          </a>
          <a
            class="inline-flex w-fit rounded-full border border-white/20 px-8 py-5 text-base font-medium text-white/75 transition hover:border-[#f4e8d0] hover:text-[#f4e8d0]"
            href="#concept"
          >
            {t.home.secondaryCta}
          </a>
        </div>
      </div>

      <div
        class="relative mx-auto hidden min-h-[560px] w-full max-w-[460px] lg:block"
        aria-hidden="true"
      >
        <div
          class="absolute inset-x-10 top-4 h-96 rounded-full bg-[#f4e8d0]/10 blur-3xl"
        >
        </div>
        <img
          class="relative mx-auto h-[560px] w-auto object-contain drop-shadow-[0_40px_80px_rgba(0,0,0,0.75)]"
          src={forkSpaghetti.src}
          width={forkSpaghetti.width}
          height={forkSpaghetti.height}
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </Container>
</section>

<section id="concept" class="bg-[#0d0d0d] py-20 text-white md:py-28">
  <Container>
    <div
      class="grid gap-8 border-t border-white/10 pt-12 md:grid-cols-[0.85fr_1.15fr] md:items-start"
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.24em] text-[#f4e8d0]/60"
      >
        01 / Concept
      </p>
      <div>
        <h2
          class="max-w-4xl text-4xl font-black leading-none tracking-[-0.055em] text-[#e9e4db] md:text-6xl"
        >
          {t.home.sections.conceptTitle}
        </h2>
        <p
          class="mt-6 max-w-3xl text-xl leading-8 tracking-[-0.035em] text-white/65"
        >
          {t.home.sections.conceptText}
        </p>
      </div>
    </div>
  </Container>
</section>

<section id="styles" class="bg-[#f4e8d0] py-20 text-black md:py-28">
  <Container>
    <div class="grid gap-10 md:grid-cols-3">
      <div class="md:col-span-2">
        <p
          class="text-sm font-semibold uppercase tracking-[0.24em] text-black/50"
        >
          02 / Styles
        </p>
        <h2
          class="mt-5 max-w-4xl text-4xl font-black leading-none tracking-[-0.055em] md:text-6xl"
        >
          {t.home.sections.stylesTitle}
        </h2>
      </div>
      <p class="self-end text-xl leading-8 tracking-[-0.035em] text-black/65">
        {t.home.sections.stylesText}
      </p>
    </div>
  </Container>
</section>

<section id="pricing" class="bg-[#0d0d0d] py-20 text-white md:py-28">
  <Container>
    <div
      class="grid gap-8 border-t border-white/10 pt-12 md:grid-cols-[0.9fr_1.1fr] md:items-end"
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.24em] text-[#f4e8d0]/60"
      >
        {t.home.sections.pricingLabel}
      </p>
      <p
        class="max-w-3xl text-3xl font-black leading-tight tracking-[-0.055em] text-[#e9e4db] md:text-5xl"
      >
        {t.home.sections.pricingText}
      </p>
    </div>
  </Container>
</section>

<section id="demo" class="bg-[#0d0d0d] py-20 text-white md:py-28">
  <Container>
    <div
      class="rounded-[2.5rem] border border-white/10 bg-white/[0.03] p-8 md:p-12"
    >
      <p
        class="text-sm font-semibold uppercase tracking-[0.24em] text-[#f4e8d0]/60"
      >
        03 / Demo
      </p>
      <h2
        class="mt-5 max-w-4xl text-4xl font-black leading-none tracking-[-0.055em] text-[#e9e4db] md:text-6xl"
      >
        {t.home.sections.demoTitle}
      </h2>
      <p
        class="mt-6 max-w-3xl text-xl leading-8 tracking-[-0.035em] text-white/65"
      >
        {t.home.sections.demoText}
      </p>
    </div>
  </Container>
</section>
