---
import type { Locale } from "../../i18n/config";
import HeroSection from "./home/HeroSection.astro";
import ConceptBridge from "./home/ConceptBridge.astro";
import SocialProof from "./home/SocialProof.astro";
import BrandWorldShowcase from "./home/BrandWorldShowcase.astro";
import ServicesSection from "./home/ServicesSection.astro";
import PricingPreview from "./home/PricingPreview.astro";
import ProcessSection from "./home/ProcessSection.astro";
import FinalCta from "./home/FinalCta.astro";

const { locale } = Astro.props as { locale: Locale };
---

<HeroSection locale={locale} />
<ConceptBridge locale={locale} />
<SocialProof locale={locale} />
<BrandWorldShowcase locale={locale} />
<ServicesSection locale={locale} />
<PricingPreview locale={locale} />
<ProcessSection locale={locale} />
<FinalCta locale={locale} />

<script>
  import "../../scripts/motion";
</script>
