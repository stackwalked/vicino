---
import Container from "../ui/Container.astro";
import { localeLabels, locales, type Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n";
import { getNavigation } from "../../data/navigation";
import { contact } from "../../data/contact";
import { getLocalizedPath } from "../../data/site";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const navigation = getNavigation(locale);
---

<header class="fixed inset-x-0 top-0 z-20 py-4 text-white transition-all duration-500 ease-in-out" id="site-header">
  <Container>
    <div class="grid items-center gap-6 lg:grid-cols-[1fr_auto_1fr]">
      <nav
        class="hidden items-center gap-8 text-[15px] font-medium lg:flex"
        aria-label="Primary navigation"
      >
        {
          navigation.primary.map((item) => (
            <a class="transition hover:text-[#f4e8d0]" href={item.href}>
              {t.nav[item.key]}
            </a>
          ))
        }
      </nav>

      <a
        class="flex items-center justify-center gap-3 justify-self-start lg:justify-self-center"
        href={getLocalizedPath(locale)}
        aria-label="VICINO home"
      >
        <span
          class="grid size-8 place-items-center rounded-full border border-white/90 text-[15px] leading-none"
          >🍴</span
        >
        <span
          class="text-3xl font-black lowercase leading-none tracking-[-0.08em]"
          >vicino</span
        >
      </a>

      <div
        class="flex items-center justify-end gap-5 justify-self-end text-[15px] font-medium"
      >
        <nav
          class="hidden items-center gap-8 lg:flex"
          aria-label="Secondary navigation"
        >
          {
            navigation.secondary.map((item) => (
              <a class="transition hover:text-[#f4e8d0]" href={item.href}>
                {t.nav[item.key]}
              </a>
            ))
          }
        </nav>

        <div
          class="hidden items-center gap-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/70 sm:flex"
          aria-label="Language selection"
        >
          {
            locales.map((availableLocale) => (
              <a
                class:list={[
                  "rounded-full px-2 py-1 transition hover:text-white",
                  availableLocale === locale &&
                    "bg-white !text-[#111113] hover:!text-[#111113] focus-visible:!text-[#111113]",
                ]}
                href={getLocalizedPath(availableLocale)}
                hreflang={availableLocale}
                aria-label={localeLabels[availableLocale]}
                aria-current={availableLocale === locale ? "page" : undefined}
              >
                {availableLocale}
              </a>
            ))
          }
        </div>

        <a
          class="hidden rounded-full border border-[#f4e8d0] px-5 py-2 text-sm font-semibold text-[#f4e8d0] transition hover:bg-[#f4e8d0] hover:!text-[#111113] focus-visible:bg-[#f4e8d0] focus-visible:!text-[#111113] md:inline-flex whitespace-nowrap"
          href={contact.whatsappUrl}
          rel="noreferrer"
          target="_blank"
        >
          {t.nav.createPreview}
        </a>
      </div>
    </div>
  </Container>
</header>

<script>
  const header = document.getElementById("site-header");
  const threshold = window.innerHeight * 2.5;

  const hideZone = window.innerHeight * 0.3;

  function update() {
    if (window.scrollY > threshold) {
      header?.classList.remove("-translate-y-full");
      header?.classList.add("bg-[#111113]/80", "backdrop-blur-md", "border-b", "border-white/8");
    } else if (window.scrollY > hideZone) {
      header?.classList.add("-translate-y-full");
      header?.classList.remove("bg-[#111113]/80", "backdrop-blur-md", "border-b", "border-white/8");
    } else {
      header?.classList.remove("-translate-y-full");
      header?.classList.remove("bg-[#111113]/80", "backdrop-blur-md", "border-b", "border-white/8");
    }
  }

  window.addEventListener("scroll", update, { passive: true });
  update();
</script>
