---
import Container from "../ui/Container.astro";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n";
import { getNavigation } from "../../data/navigation";
import { contact } from "../../data/contact";
import { getLocalizedPath } from "../../data/site";

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const navigation = getNavigation(locale);
const footerNavigation = [...navigation.primary, ...navigation.secondary];
---

<footer
  id="contact-details"
  class="border-t border-white/10 bg-[#111113] py-14 text-white md:py-20"
>
  <Container>
    <div
      class="grid gap-12 text-sm md:grid-cols-[1.5fr_0.9fr_0.9fr_0.9fr] md:gap-16"
    >
      <div>
        <h2 class="text-sm font-semibold text-white/60">{t.footer.contact}</h2>
        <ul class="mt-5 space-y-3 text-white/90">
          <li>
            <a
              class="transition hover:text-[#f4e8d0]"
              href={contact.whatsappUrl}
              rel="noreferrer"
              target="_blank">{contact.phoneDisplay}</a
            >
          </li>
          <li>
            <a
              class="transition hover:text-[#f4e8d0]"
              href={`mailto:${contact.email}`}>{contact.email}</a
            >
          </li>
        </ul>
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="text-sm font-bold uppercase tracking-[0.08em] text-white/60">
          VICINO
        </h2>
        <ul class="mt-5 space-y-3 text-white/90">
          {
            footerNavigation.map((item) => (
              <li>
                <a class="transition hover:text-[#f4e8d0]" href={item.href}>
                  {t.nav[item.key]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Social links">
        <h2 class="text-sm font-semibold text-white/60">{t.footer.follow}</h2>
        <ul class="mt-5 space-y-3 text-white/90">
          <li>
            <a
              class="transition hover:text-[#f4e8d0]"
              href="https://www.instagram.com/"
              rel="noreferrer"
              target="_blank">Instagram</a
            >
          </li>
          <li>
            <a
              class="transition hover:text-[#f4e8d0]"
              href="https://www.facebook.com/"
              rel="noreferrer"
              target="_blank">Facebook</a
            >
          </li>
          <li>
            <a
              class="transition hover:text-[#f4e8d0]"
              href="https://www.tiktok.com/"
              rel="noreferrer"
              target="_blank">TikTok</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-label="Legal links">
        <h2 class="text-sm font-semibold text-white/60">{t.footer.legal}</h2>
        <ul class="mt-5 space-y-3 text-white/90">
          <li class="flex flex-wrap items-center gap-2">
            <span>{t.footer.terms}</span>
            <span
              class="rounded-full bg-white/8 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-white/45"
              >{t.footer.comingSoon}</span
            >
          </li>
          <li class="flex flex-wrap items-center gap-2">
            <span>{t.footer.privacy}</span>
            <span
              class="rounded-full bg-white/8 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-white/45"
              >{t.footer.comingSoon}</span
            >
          </li>
          <li class="flex flex-wrap items-center gap-2">
            <span>{t.footer.cookies}</span>
            <span
              class="rounded-full bg-white/8 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-white/45"
              >{t.footer.comingSoon}</span
            >
          </li>
        </ul>
      </nav>
    </div>

    <a
      class="mx-auto mt-16 flex w-fit items-center justify-center gap-3 md:mt-20"
      href={getLocalizedPath(locale)}
      aria-label="VICINO home"
    >
      <span
        class="grid size-9 place-items-center rounded-full border border-white/90 text-[17px] leading-none"
        >🍴</span
      >
      <span
        class="text-5xl font-black uppercase leading-none tracking-[-0.08em] md:text-6xl"
        >VICINO</span
      >
    </a>
  </Container>
</footer>
